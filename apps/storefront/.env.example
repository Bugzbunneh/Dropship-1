# Copy to .env (or .env.local) and fill in. Both are gitignored.
#
# Put each description on its own comment line, never after a value: everything after the
# first "=" on a line is part of the value.

# Which store this deployment serves. Must match a folder registered in stores/index.ts.
STORE=pet-pilot

# The store's id in the Supabase `stores` table. Printed by `pnpm store:provision pet-pilot`.
STORE_ID=

# Shared secret for POST /api/revalidate. Generate a long random value per deployment.
# If unset, the route refuses every request.
REVALIDATE_SECRET=

# Supabase project URL and publishable key (both public, safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. The project's legacy JWT secret (Project Settings, JWT Keys). Signs the
# store-scoped token the storefront sends to Supabase. Never expose it to the browser.
SUPABASE_JWT_SIGNING_KEY=

# Stripe, test mode keys (sk_test_..., pk_test_...). Server only except the publishable key.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Signs the events Stripe sends to POST /api/stripe/webhook. At deploy time, register that address
# in Stripe (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.expired) and paste the endpoint's signing secret here (whsec_...). For local
# tests any long random value will do: the live test signs its own events with it.
STRIPE_WEBHOOK_SECRET=

# Sends order emails (confirmation, shipped, delivered) through Resend. Without it the emails stay
# queued in the database and go out once a key is added. Resend only delivers to your own address
# until the sending domain is verified in their dashboard.
# RESEND_API_KEY=re_...

# Where the catalog comes from. Leave this out to read the Supabase database. "fixtures" serves
# the built-in demo catalog from the store's seed file with no database or credentials, which is
# what CI, `pnpm smoke` and `pnpm e2e` use. Read when the app starts and when it is built.
# CATALOG_SOURCE=fixtures

# Search engines may index the site only when this is exactly "true". Leave it out on staging
# and previews. It is baked into page metadata at build time, so set it for the production
# build, not just at runtime.
# ALLOW_INDEXING=true

# The public address used for canonical links, social previews and the sitemap. Defaults to
# https://<the store's domain>. Set it for staging and previews.
# NEXT_PUBLIC_SITE_URL=https://staging.example.com
