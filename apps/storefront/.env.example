# Which store this deployment serves. Must match a folder registered in stores/index.ts.
STORE=pet-pilot

# Shared secret for POST /api/revalidate. Generate a long random value per deployment.
# If unset, the route refuses every request.
REVALIDATE_SECRET=

# Added as the later Phase 0 steps land:
# STORE_ID=                      the store's id in the Supabase `stores` table
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_JWT_SIGNING_KEY=      used to mint the storefront's store-scoped JWT (server only)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
