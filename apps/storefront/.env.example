# Copy to .env (or .env.local) and fill in. Both are gitignored.
#
# Put each description on its own comment line, never after a value: everything after the
# first "=" on a line is part of the value.

# Which store this deployment serves. Must match a folder registered in stores/index.ts.
STORE=pet-pilot

# The store's id in the Supabase `stores` table. Printed by `pnpm store:provision pet-pilot`.
STORE_ID=

# Shared secret for POST /api/revalidate. Generate a long random value per deployment.
# If unset, the route refuses every request.
REVALIDATE_SECRET=

# Supabase project URL and publishable key (both public, safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. The project's legacy JWT secret (Project Settings, JWT Keys). Signs the
# store-scoped token the storefront sends to Supabase. Never expose it to the browser.
SUPABASE_JWT_SIGNING_KEY=

# Stripe, test mode keys (sk_test_..., pk_test_...). Server only except the publishable key.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Only needed once webhooks are built (Phase 2).
STRIPE_WEBHOOK_SECRET=
